# Copy this file to .env (same folder) and fill in values. .env is never committed.

# Meta Model API key from dev.meta.ai > API keys. Needed from Day 3 (AI planning).
META_API_KEY=

# Transcription: "local" (this computer, no account) or "modal" (GPU, needs a Modal account)
TRANSCRIBE_BACKEND=local
# base.en is fast; small.en is more accurate but slower on a laptop
WHISPER_MODEL=base.en
